+ */
+/*
+ * eventfd_compat.h - eventfd replacement for kernels without CONFIG_EVENTFD
+ *
+ * Some vendor kernels (e.g. Qualcomm IPQ50xx OpenWrt builds) are compiled
+ * without CONFIG_EVENTFD, so eventfd() returns ENOSYS.  SmartDNS only uses
+ * eventfd as an epoll wakeup handle: a thread writes 8 bytes and the epoll
+ * loop wakes up, reads them and ignores the value.
+ *
+ * A connected UDP socket on loopback gives exactly the same single-fd
+ * read/write semantics, so every existing call site keeps working unchanged.
+ *
+ * Limitations: initval and EFD_SEMAPHORE are not supported; the returned
+ * descriptor is always non-blocking and close-on-exec.  All current call
+ * sites use eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK), so this is sufficient.
+ */
+#ifndef SMARTDNS_EVENTFD_COMPAT_H
+#define SMARTDNS_EVENTFD_COMPAT_H
+
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+/* values from <sys/eventfd.h>; kept here so we do not need that header */
+#ifndef EFD_CLOEXEC
+#define EFD_CLOEXEC O_CLOEXEC
+#endif
+#ifndef EFD_NONBLOCK
+#define EFD_NONBLOCK O_NONBLOCK
+#endif
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+static inline int smartdns_eventfd(unsigned int initval, int flags)
+{
+	int fd;
+	struct sockaddr_in addr;
+	socklen_t addrlen;
+
+	(void)initval;
+	(void)flags; /* call sites pass EFD_CLOEXEC | EFD_NONBLOCK */
+
+	fd = socket(AF_INET, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if (fd < 0) {
+		return -1;
+	}
+
+	memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	addr.sin_port = 0;
+
+	if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	addrlen = sizeof(addr);
+	if (getsockname(fd, (struct sockaddr *)&addr, &addrlen) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	return fd;
+}
+
+#define eventfd smartdns_eventfd
+
+#endif /* SMARTDNS_EVENTFD_COMPAT_H */
